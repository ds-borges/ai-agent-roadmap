      "parameters": {
        "jsCode": "const messagesData = $('Supabase: Get Messages').all().map(i => i.json);\n\nif (!messagesData || messagesData.length === 0) {\n  return [];\n}\n\nconst ecommerceIds = [];\nconst ecommerceMsgs = [];\nconst localIds = [];\nconst localMsgs = [];\nconst allIds = [];\n\nfor (const m of messagesData) {\n  const g = m.group_name || \"\";\n  const text = (m.message || \"\").replace(/\\r?\\n|\\r/g, \" \").trim();\n  \n  if (!text) continue;\n\n  allIds.push(m.id);\n\n  if (g.includes(\"Cashback\")) {\n    ecommerceIds.push(m.id);\n    ecommerceMsgs.push(text);\n  } else {\n    localIds.push(m.id);\n    localMsgs.push(`[${g}] ${text}`);\n  }\n}\n\nreturn [{\n  json: {\n    message_ids: allIds,             // Todos os IDs\n    ecommerce_ids: ecommerceIds,     // Apenas os IDs do E-commerce\n    ecommerce_payload: ecommerceMsgs,// Payload do E-commerce\n    local_ids: localIds,             // Apenas os IDs do Local\n    local_payload: localMsgs         // Payload do Local\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -16
      ],
      "id": "b6b6618f-d122-4764-819e-db9ac2b8a3e5",
