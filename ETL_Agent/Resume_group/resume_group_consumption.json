    {
      "parameters": {
        "jsCode": "// Puxa as mensagens do Supabase\nconst messagesData = $('Supabase: Get Messages').all().map(i => i.json);\n\nif (!messagesData || messagesData.length === 0) {\n  return [];\n}\n\n// Payload ultraleve: apenas id, grupo e texto limpo\nconst messages = messagesData.map(m => ({\n  group: m.group_name || \"G\",\n  offers: (m.message || \"\").replace(/\\r?\\n|\\r/g, \" \").trim() // coloca em linha única para enxugar ainda mais\n}));\n\nreturn [{\n  json: {\n    total_messages: messages.length,\n    messages_payload: messages\n  }\n}];"
      },
