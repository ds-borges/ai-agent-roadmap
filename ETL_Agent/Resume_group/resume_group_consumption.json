      "parameters": {
        "jsCode": "const rawText = $input.first().json.content.parts[0].text;\n\nlet parsed = { ecommerce: [], local: [] };\ntry {\n  parsed = JSON.parse(rawText);\n} catch (e) {\n  parsed = { ecommerce: [], local: [] };\n}\n\nconst ecom = parsed.ecommerce || [];\nconst loc = parsed.local || [];\n\nif (ecom.length === 0 && loc.length === 0) {\n  return [{ json: { has_content: false } }];\n}\n\n// 1. Texto falado (sem links, sem emojis que o TTS tenta soletrar)\nlet speech = \"Aqui está o seu resumo de oportunidades. \";\n\nif (ecom.length > 0) {\n  speech += \"Nas ofertas online: \";\n  for (const item of ecom) {\n    speech += `${item.item}, saindo por ${item.preco}. `;\n    if (item.cupom) speech += `Com o cupom ${item.cupom}. `;\n  }\n}\n\nif (loc.length > 0) {\n  speech += \"Nos classificados de Jataí: \";\n  for (const item of loc) {\n    speech += `No grupo ${item.grupo}, ${item.item}, por ${item.preco}. `;\n  }\n}\n\n// 2. Mantém o texto visual para enviar como legenda ou mensagem de apoio\nlet visualText = \"⚡ *RADAR DE OPORTUNIDADES*\\n\\n\";\nif (ecom.length > 0) {\n  visualText += \"🛒 *E-COMMERCE*\\n\";\n  for (const item of ecom) {\n    visualText += `• *${item.item}* - ${item.preco}\\n  🔗 [Link](${item.link})\\n`;\n  }\n}\n\nreturn [{\n  json: {\n    has_content: true,\n    speech_script: speech,\n    caption_text: visualText\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1584,
        -96
      ],
      "id": "1bcd77f7-a711-49b2-b042-769926c1fbe2",
      "name": "text_to_spech"
    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.content.parts[0].text;\n\nlet parsed = { ecommerce: [], local: [] };\ntry {\n  // Limpa possíveis blocos ```json ... ``` que o modelo possa devolver\n  const cleanedText = rawText.replace(/```json|```/gi, '').trim();\n  parsed = JSON.parse(cleanedText);\n} catch (e) {\n  parsed = { ecommerce: [], local: [] };\n}\n\nconst ecom = parsed.ecommerce || [];\nconst loc = parsed.local || [];\n\nif (ecom.length === 0 && loc.length === 0) {\n  return [{ json: { has_content: false } }];\n}\n\n// 1. Texto falado (TTS)\nlet speech = \"Aqui está o seu resumo de oportunidades. \";\n\nif (ecom.length > 0) {\n  speech += \"Nas ofertas online: \";\n  for (const item of ecom) {\n    speech += `${item.item}, saindo por ${item.preco}. `;\n    if (item.cupom) speech += `Com o cupom ${item.cupom}. `;\n  }\n}\n\nif (loc.length > 0) {\n  speech += \"Nos classificados locais: \";\n  for (const item of loc) {\n    speech += `No grupo ${item.grupo}, ${item.item}, por ${item.preco}. `;\n  }\n}\n\n// 2. Texto visual (Legenda / WhatsApp)\nlet visualText = \"⚡ *RADAR DE OPORTUNIDADES*\\n\\n\";\n\nif (ecom.length > 0) {\n  visualText += \"🛒 *E-COMMERCE*\\n\";\n  for (const item of ecom) {\n    visualText += `• *${item.item}* - ${item.preco}\\n`;\n    if (item.cupom) visualText += `  🏷️ Cupom: \\`${item.cupom}\\`\\n`;\n    if (item.link) visualText += `  🔗 [Link](${item.link})\\n`;\n  }\n  visualText += \"\\n\";\n}\n\nif (loc.length > 0) {\n  visualText += \"📍 *CLASSIFICADOS LOCAIS*\\n\";\n  for (const item of loc) {\n    visualText += `• [${item.grupo}] *${item.item}* - ${item.preco}\\n`;\n    if (item.contato) visualText += `  📞 Contato: ${item.contato}\\n`;\n  }\n}\n\nreturn [{\n  json: {\n    has_content: true,\n    speech_script: speech.trim(),\n    caption_text: visualText.trim()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1584,
