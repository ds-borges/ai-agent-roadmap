    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst msg = input.body?.data?.message;\n\n// 1. Extração do texto\nconst text = (\n  msg?.conversation || \n  msg?.extendedTextMessage?.text || \n  msg?.imageMessage?.caption || \n  msg?.videoMessage?.caption || \n  \"\"\n).trim();\n\nconst group = input.body?.data?.key?.remoteJid || \"\";\n\n// Descarta mensagens muito curtas ou palavras soltas (< 15 caracteres)\nif (!text || text.length < 15) {\n  return [];\n}\n\n// 2. Blacklist de Serviços, Spam e Golpes\nconst isLiveAnimal = /(filhote|shitzu|shihtzu|pitbull|pastor\\s*alem[ãa]o|adop[çc][ãa]o|ado[çc][ãa]o|para\\s*cruzar|cadela|doa-se\\s*(cachorro|gato|gatinho))/i.test(text);\nconst isServiceOrRent = /(aluga-se\\s*(casa|kitnet|quarto)|fa[çc]o\\s*faxina|diarista|sobrancelha|manicure)/i.test(text);\nconst isTelecomSpam = /(fibra\\s*[oó]pt?ica|internet\\s*fibra|instala[çc][ãa]o\\s*gr[áa]tis|algu[ée]m\\s*precisando\\s*(de\\s*)?(internet|wi-?fi)|planos?\\s*pra\\s*sua\\s*casa|ultra\\s*velocidade)/i.test(text);\nconst isFinancialSpam = /(maquininha(\\s*ton|\\s*pagseguro|\\s*infinitepay|\\s*sumup)?|menor\\s*taxa\\s*do\\s*brasil|empr[ée]stimo\\s*fgts|antecipa[çc][ãa]o|cons[óo]rcio|financiamento|consultor\\s*de\\s*vendas|abrindo\\s*credi[áa]rio)/i.test(text);\nconst isIptvSpam = /(iptv|p2p|grade\\s*de\\s*canais|canais\\s*abertos\\s*e\\s*fechados|liberamos\\s*conte[úu]dos|tv\\s*box|smart\\s*iptv|reais\\s*mensais)/i.test(text);\n\n// 3. Blacklist de Conversas, Opiniões, Reclamações, Dúvidas e Histórias\nconst isChatOrOpinion = /(n[ãa]o\\s*confio|n[ãa]o\\s*presta|recomendo|algu[ée]m\\s*(tem|sabe|indica|vende|conhece)|procuro|compro|onde\\s*(acho|encontro)|acabei\\s*de\\s*pedir|pedi\\s*um\\s*(lanche|hamb[úu]rguer|pizza)|comprei|pedi\\s*devolu[çc][ãa]o|fiquei\\s*com|veio\\s*com\\s*defeito)/i.test(text);\n\n// 4. Blacklist de Links Sociais, Convites e Perfis de Vendedor\nconst isBadLink = /(chat\\.whatsapp\\.com|wa\\.me\\/|api\\.whatsapp\\.com|t\\.me\\/|telegram\\.me|instagram\\.com|facebook\\.com|tiktok\\.com|vendedor\\.site|mercadolivre\\.com(\\.br)?\\/social\\/)/i.test(text);\n\nif (isLiveAnimal || isServiceOrRent || isTelecomSpam || isFinancialSpam || isIptvSpam || isChatOrOpinion || isBadLink) {\n  return [];\n}\n\n// 5. Filtro Anti-Ruído (Conversas curtas)\nconst noiseRegex = /^(kkk|haha|rsrs|bom dia|boa tarde|boa noite|obrigad[oa]|valeu|show|up)\\b/i;\nif (noiseRegex.test(text) && text.length < 40) {\n  return [];\n}\n\n// 6. Descarta mensagens sem descrição do produto (ex: \"Vendo R$200\", \"Vendo. Aceito propostas.\")\nif (/^(vendo|vende-se|aceito\\s*propostas?|troco)(\\s*(r\\$|\\$)?\\s*\\d+)?(\\s*aceito\\s*propostas?)?\\.?$/i.test(text.trim())) {\n  return [];\n}\n\n// 7. Detecção de Oferta / Venda / Produto Genérico\nconst priceRegex = /(r\\$|rs\\b|rs:|reais|reias|\\$\\s*\\d+|\\b\\d+\\s*reais\\b|\\b[pmg]\\s+\\d{1,4}\\b)/i;\nconst promoKeywordsRegex = /(cupom|desconto|\\b\\d+%\\s*off\\b|frete\\s*gr[áa]tis|menor\\s*pre[çc]o|promo[çc][ãa]o|oferta|cashback|comprar|vend[eo]|vendo\\s*ou\\s*troco)/i;\nconst hasEcommerceLink = /(amzn\\.to|link\\.amazon|amazon\\.com|shope\\.ee|shopee\\.com|mercadolivre\\.com|mercadolivre\\.com\\.br|magalu\\.me|magazineluiza\\.com|aliexpress\\.com|kabum\\.com|terabyteshop\\.com|pichau\\.com|casasbahia\\.com)/i.test(text);\n\nconst isOffer = priceRegex.test(text) || promoKeywordsRegex.test(text) || hasEcommerceLink;\n\nif (!isOffer) {\n  return [];\n}\n\nreturn [{\n  json: {\n    group,\n    message: text\n  }\n}];"
      },
